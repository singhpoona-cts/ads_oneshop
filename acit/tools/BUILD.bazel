load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
  name = "generate_test_data_lib",
  srcs = ["generate_test_data.py"],
  deps = [
      "@acit_deps//absl_py",
      "@acit_deps//google_ads",
  ]
)

py_binary(
  name = "generate_test_data",
  srcs = ["generate_test_data.py"],
  deps = [":generate_test_data_lib"],
)

py_test(
  name = "generate_test_data_test",
  main = "test_generate_test_data.py",
  srcs = ["test_generate_test_data.py"],
  deps = [
      ":generate_test_data_lib",
      "@acit_deps//absl_py",
  ],
)
