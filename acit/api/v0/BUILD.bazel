load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")

package(default_visibility = ["//visibility:public"])

proto_library(
  name = "schema_proto",
  srcs = [
      "storage/schema.proto"
  ],
  deps = [
      "@protoc_gen_bq_schema//:protos_proto",
      "@googleapis//google/shopping/merchant/products/v1:products_proto",
      "@googleapis//google/shopping/merchant/accounts/v1:accounts_proto",
  ]
)

py_proto_library(
  name = "schema_py_pb2",
  deps = [
      ":schema_proto",
  ]
)

run_binary(
    name = "bq_gen_schemas",
    srcs = [
        # The tool has to be declared
        "//:protoc_gen_bq_schema",
        # We can't use -I, so we have to pass these instead
        "@protoc_gen_bq_schema//:protos_proto",
        "@protobuf//:descriptor_proto",
        ":schema_proto",
        # The file we actually want to process
        ":storage/schema.proto",
        # Google APIs descriptor sets
        "@googleapis//google/shopping/merchant/products/v1:products_proto",
        "@googleapis//google/shopping/merchant/accounts/v1:accounts_proto",
        # Transitive dependencies of Google APIs
        "@googleapis//google/api:annotations_proto",
        "@googleapis//google/api:client_proto",
        "@googleapis//google/api:field_behavior_proto",
        "@googleapis//google/api:resource_proto",
        "@googleapis//google/api:http_proto",
        "@googleapis//google/api:launch_stage_proto",
        "@googleapis//google/shopping/type:type_proto",
        "@googleapis//google/type:interval_proto",
        "@protobuf//:timestamp_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:field_mask_proto",
        "@protobuf//:duration_proto",
    ],
    outs = [
        "storage/Products.schema",
        "storage/liasettings.schema",
    ],
    args = [
        # alias the plugin because names are hard
        "--plugin=protoc-gen-bq-schema=$(location //:protoc_gen_bq_schema)",
        # magic output directory string
        "--bq-schema_out=bazel-out/k8-fastbuild/bin/",
        "--bq-schema_opt=enum-as-string",
        "--descriptor_set_in=" +
        "$(location @protoc_gen_bq_schema//:protos_proto):" +
        "$(location //acit/api/v0:schema_proto):" +
        "$(location @protobuf//:descriptor_proto):" +
        "$(location @googleapis//google/shopping/merchant/products/v1:products_proto):" +
        "$(location @googleapis//google/shopping/merchant/accounts/v1:accounts_proto):" +
        "$(location @googleapis//google/api:annotations_proto):" +
        "$(location @googleapis//google/api:client_proto):" +
        "$(location @googleapis//google/api:field_behavior_proto):" +
        "$(location @googleapis//google/api:resource_proto):" +
        "$(location @googleapis//google/api:http_proto):" +
        "$(location @googleapis//google/api:launch_stage_proto):" +
        "$(location @googleapis//google/shopping/type:type_proto):" +
        "$(location @googleapis//google/type:interval_proto):" +
        "$(location @protobuf//:timestamp_proto):" +
        "$(location @protobuf//:empty_proto):" +
        "$(location @protobuf//:field_mask_proto):" +
        "$(location @protobuf//:duration_proto)",
        "$(location :storage/schema.proto)"
    ],
    # Reuse the existing precompiled protoc
    tool = "@toolchains_protoc_hub.linux_x86_64//:bin/protoc",
)
