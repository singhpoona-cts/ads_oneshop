# This package contains toolchain definitions.
# The convention is to use the "@acit_deps//tools" repository to make precompiled
# golang tools available to the bazel toolchain.

load("@protobuf//bazel/toolchains:proto_lang_toolchain.bzl", "proto_lang_toolchain")

# This toolchain uses a precompiled protoc binary from @acit_deps//protobuf,
# avoiding recompilation of protoc itself, which saves significant space
# and time in Cloud Shell environments.
proto_lang_toolchain(
    name = "protoc_py_toolchain",
    command_line = "--python_out=%s",
    progress_message = "Generating Python proto_library %{label}",
    runtime = "@acit_deps//protobuf",
    toolchain_type = "@rules_python//python/proto:toolchain_type",
)

